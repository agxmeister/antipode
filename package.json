{
  "name": "antipod",
  "version": "0.1.0",
  "private": true,
  "description": "Antipode: a single-Owner daemon that turns Task contracts into Evidence-backed Reviews on Telegram",
  "type": "module",
  "bin": {
    "antipod": "dist/app/cli.js"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "grammy": "~1.46.0",
    "pino": "^10.4.0",
    "pino-roll": "^3.1.0",
    "yaml": "^2.9.1",
    "zod": "~4.6.7"
  },
  "devDependencies": {
    "@swc/core": "^1.16.22",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "dependency-cruiser": "^18.7.2",
    "typescript": "~7.0.2",
    "vitest": "^4.1.12"
  }
}
